EXPO_PUBLIC_SUPABASE_URL=https://<votre-projet>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<clé anon publique>

# Identifiants Apple / EAS (à confirmer, voir docs/ios-testflight.md)
